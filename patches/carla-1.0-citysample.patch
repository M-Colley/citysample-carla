+  /// Whether World Partition HLOD proxy meshes get a label.
+  ///
+  /// Off by default: one merged proxy spans many semantic classes, so any
+  /// single label is wrong at every silhouette boundary, and leaving it
+  /// untagged lets the camera fall through to the real streamed meshes.
+  /// Turn it on ([CarlaTagger] bTagHLODProxies=True) when the view is
+  /// dominated by proxies and a coarse label beats none at all.
+  bool ShouldTagHLODProxies()
+  {
+    static bool bCached = false;
+    static bool bValue = false;
+    if (!bCached)
+    {
+      GConfig->GetBool(TEXT("CarlaTagger"), TEXT("bTagHLODProxies"), bValue, GGameIni);
+      bCached = true;
+      UE_LOG(LogCarla, Log, TEXT("CarlaTagger: HLOD proxies are %s"),
+             bValue ? TEXT("TAGGED") : TEXT("skipped"));
+    }
+    return bValue;
+  }
+}
+
+crp::CityObjectLabel ATagger::GetLabelByAssetPath(const FString &Path)
+{
+  if (!bPathLabelRulesLoaded)
+  {
+    LoadPathLabelRules();
+  }
+  for (const FCarlaPathLabelRule &Rule : GPathLabelRules)
+  {
+    // Anchor at a folder, asset ('.'), or kit boundary so "/Game/Prop" does not
+    // also swallow a future "/Game/Props", while asset-exact rules such as
+    // "/Game/Lighting/Mesh/SM_dome" match "/Game/Lighting/Mesh/SM_dome.SM_dome".
+    if (Path.Equals(Rule.Prefix, ESearchCase::IgnoreCase) ||
+        Path.StartsWith(Rule.Prefix + TEXT("/"), ESearchCase::IgnoreCase) ||
+        Path.StartsWith(Rule.Prefix + TEXT("."), ESearchCase::IgnoreCase) ||
+        (Rule.Prefix.EndsWith(TEXT("_")) &&
+         Path.StartsWith(Rule.Prefix, ESearchCase::IgnoreCase)))
+    {
+      return Rule.Label;
+    }
+  }
+  return crp::CityObjectLabel::None;
+}
+
+void ATagger::ReloadPathLabelRules()
+{
+  GConfig->Flush(true, GGameIni);
+  LoadPathLabelRules();
+}
