+int32 ATagger::TagNewActorsInWorld(
+    UWorld &World,
+    TMap<FObjectKey, int32> &TaggedActors,
+    bool bTagForSemanticSegmentation)
+{
+  GTaggerStats = FTaggerStats{};
+  int32 NewlyTaggedActors = 0;
+  int32 TotalActors = 0;
+  for (TActorIterator<AActor> it(&World); it; ++it)
+  {
+    AActor *Actor = *it;
+    if (Actor == nullptr)
+    {
+      continue;
+    }
+    ++TotalActors;
+    TInlineComponentArray<UStaticMeshComponent *> StaticComps(Actor);
+    TInlineComponentArray<USkeletalMeshComponent *> SkelComps(Actor);
+    const int32 CompCount = StaticComps.Num() + SkelComps.Num();
+    const FObjectKey Key(Actor);
+    if (const int32 *PrevCount = TaggedActors.Find(Key))
+    {
+      if (*PrevCount == CompCount)
+      {
+        continue;
+      }
+    }
+    TagActor(*Actor, bTagForSemanticSegmentation);
+    TaggedActors.Add(Key, CompCount);
+    ++NewlyTaggedActors;
+  }
+  if (TaggedActors.Num() > TotalActors * 2 + 128)
+  {
+    for (auto MapIt = TaggedActors.CreateIterator(); MapIt; ++MapIt)
+    {
+      if (MapIt.Key().ResolveObjectPtr() == nullptr)
+      {
+        MapIt.RemoveCurrent();
+      }
+    }
+  }
+  if (NewlyTaggedActors > 0)
+  {
+    LogTaggerCensus(TEXT("streaming-delta"));
+  }
+  return NewlyTaggedActors;
 }
 
