+// ===========================================================================
+//  Asset-path label rules
+// ===========================================================================
+//
+// CARLA's original GetLabelByPath reads the folder immediately after a "Static"
+// folder in the asset path. That only classifies content laid out the way
+// CARLA's own is. Epic's City Sample stores meshes under /Game/Building,
+// /Game/Road/Kit_*, /Game/Prop/Kit_*, /Game/Vehicle/veh*, /Game/Crowd, ... so
+// every one of its meshes resolved to None and semantic segmentation came back
+// blank.
+//
+// The table below is seeded from the actual City Sample content taxonomy.
+// Longest prefix wins, so a specific kit beats its parent folder.
+
+namespace
+{
+  struct FCarlaPathLabelRule
+  {
+    FString Prefix;
+    crp::CityObjectLabel Label;
+  };
+
+  // Seeded from the real folder listing of Content/. Order here is irrelevant -
+  // the array is sorted longest-prefix-first at load.
+  const TPair<const TCHAR *, crp::CityObjectLabel> GCitySampleDefaultRules[] =
+  {
+    // --- roads and their markings -----------------------------------------
+    { TEXT("/Game/Road/Kit_MeshDecals_"),     crp::CityObjectLabel::RoadLines    },
+    { TEXT("/Game/Road/Kit_Sidewalk_"),       crp::CityObjectLabel::Sidewalks    },
+    { TEXT("/Game/Road/Kit_Small_Curb_"),     crp::CityObjectLabel::Sidewalks    },
+    { TEXT("/Game/Road/Kit_City_Road"),       crp::CityObjectLabel::Roads        },
+    { TEXT("/Game/Road/Kit_Freeway_"),        crp::CityObjectLabel::Roads        },
+    { TEXT("/Game/Road"),                     crp::CityObjectLabel::Roads        },
+
+    // --- signage, signals, poles ------------------------------------------
+    { TEXT("/Game/AI/Traffic/TrafficLights"), crp::CityObjectLabel::TrafficLight },
+    { TEXT("/Game/Prop/Kit_BusStopSign_"),    crp::CityObjectLabel::TrafficSigns },
+    { TEXT("/Game/Prop/Kit_StopSign_"),       crp::CityObjectLabel::TrafficSigns },
+    { TEXT("/Game/Prop/Kit_StreetSign_"),     crp::CityObjectLabel::TrafficSigns },
+    { TEXT("/Game/Prop/Kit_Street_Sign_"),    crp::CityObjectLabel::TrafficSigns },
+    { TEXT("/Game/Prop/Kit_PoleSign_"),       crp::CityObjectLabel::TrafficSigns },
+    { TEXT("/Game/Prop/Kit_Sign_"),           crp::CityObjectLabel::TrafficSigns },
+    { TEXT("/Game/Prop/Kit_StreetLamp_"),     crp::CityObjectLabel::Poles        },
+
+    // --- vegetation --------------------------------------------------------
+    { TEXT("/Game/Prop/Kit_TreeBase_"),       crp::CityObjectLabel::Vegetation   },
+    { TEXT("/Game/Prop/Kit_Tree_"),           crp::CityObjectLabel::Vegetation   },
+
+    // --- barriers ----------------------------------------------------------
+    { TEXT("/Game/Prop/Kit_Barricade_"),      crp::CityObjectLabel::Fences       },
+    { TEXT("/Game/Prop/Kit_Railing_"),        crp::CityObjectLabel::Fences       },
+    { TEXT("/Game/Prop/Kit_Border_"),         crp::CityObjectLabel::Fences       },
+
+    // --- misc street furniture --------------------------------------------
+    { TEXT("/Game/Prop/Kit_Bicycle_"),        crp::CityObjectLabel::Bicycle      },
+    { TEXT("/Game/Prop/Kit_ManholeCover_"),   crp::CityObjectLabel::Ground       },
+    { TEXT("/Game/Prop/Kit_Dirt_"),           crp::CityObjectLabel::Ground       },
+    { TEXT("/Game/Prop/kit_ocean"),           crp::CityObjectLabel::Water        },
+    { TEXT("/Game/Prop/Kit_fog"),             crp::CityObjectLabel::Other        },
+    // Rooftop mechanical kit reads as part of the building silhouette.
+    { TEXT("/Game/Prop/Kit_roof_"),           crp::CityObjectLabel::Buildings    },
+    { TEXT("/Game/Prop"),                     crp::CityObjectLabel::Static       },
