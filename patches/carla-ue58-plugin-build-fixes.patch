+crp::CityObjectLabel ATagger::GetLabelByAssetPath(const FString &Path)
+{
+  if (!bPathLabelRulesLoaded)
+  {
+    LoadPathLabelRules();
+  }
+  for (const FCarlaPathLabelRule &Rule : GPathLabelRules)
+  {
+    // Anchor at a folder or kit boundary so "/Game/Prop" does not also swallow
+    // a future "/Game/Props". The bare-prefix branch is deliberate: several
+    // rules end in '_' and are meant to match mid-name.
