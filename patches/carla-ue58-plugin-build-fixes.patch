+FCarlaActor* FActorRegistry::RegisterDormant(
+    FActorDescription Description,
+    FCarlaActor::ActorType Type,
+    const TSet<crp::CityObjectLabel> &SemanticTags,
+    const FBoundingBox &BoundingBox,
+    UWorld *InWorld)
+{
+  // Separate counter: a dormant proxy must never consume an id that a real
+  // spawn would otherwise have used, or enabling the bridge would renumber
+  // every subsequently spawned actor.
+  const IdType Id = ++FActorRegistry::DORMANT_ID_COUNTER;
+
+  auto Info = MakeShared<FActorInfo>();
+  Info->Description = std::move(Description);
+  Info->SemanticTags = SemanticTags;
+  Info->BoundingBox = BoundingBox;
+
+  Info->SerializedData.id = Id;
+  Info->SerializedData.description = Info->Description;
+  Info->SerializedData.bounding_box = Info->BoundingBox;
+  Info->SerializedData.semantic_tags.reserve(Info->SemanticTags.Num());
+  for (auto &&Tag : Info->SemanticTags)
+  {
+    using tag_t = decltype(Info->SerializedData.semantic_tags)::value_type;
+    Info->SerializedData.semantic_tags.emplace_back(static_cast<tag_t>(Tag));
+  }
+
+  TSharedPtr<FCarlaActor> View =
+      FCarlaActor::ConstructCarlaActor(
+          Id, nullptr, std::move(Info), Type,
+          crp::ActorState::Dormant, InWorld);
+
+  // A null entry here is exactly what PutActorToSleep stores for a normally
+  // streamed-out actor, and it preserves the Actors/ActorDatabase size
+  // invariant that Register() checks - so Deregister(IdType) works unmodified.
+  Actors.Emplace(Id, nullptr);
+
+  TSharedPtr<FCarlaActor> &Result = ActorDatabase.Emplace(Id, MoveTemp(View));
+
+  check(static_cast<size_t>(Actors.Num()) == ActorDatabase.Num());
+  return Result.Get();
+}
