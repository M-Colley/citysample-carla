+void ACarlaGameModeBase::OnWorldPartitionStreamingUpdated()
+{
+  UWorld *World = GetWorld();
+  if (World == nullptr)
+  {
+    return;
+  }
+
+  // Streaming state updates fire every time a source moves, far more often
+  // than cells actually appear. Tagging is idempotent but walks every actor,
+  // so rate-limit it.
+  const double Now = World->GetTimeSeconds();
+  if (Now - LastStreamingRetagTime < 1.0)
+  {
+    return;
+  }
+  LastStreamingRetagTime = Now;
+
+  ATagger::TagActorsInLevel(*World, true);
+}
+
 void ACarlaGameModeBase::EndPlay(const EEndPlayReason::Type EndPlayReason)
 {
   FWorldDelegates::LevelAddedToWorld.RemoveAll(this);
+  if (StreamingStateUpdatedHandle.IsValid())
+  {
+    if (UWorld *World = GetWorld())
+    {
+      if (UWorldPartitionSubsystem *WPSubsystem = World->GetSubsystem<UWorldPartitionSubsystem>())
+      {
+        WPSubsystem->OnStreamingStateUpdated().Remove(StreamingStateUpdatedHandle);
+      }
+    }
+    StreamingStateUpdatedHandle.Reset();
+  }
   FCarlaStaticDelegates::OnEpisodeSettingsChange.Remove(OnEpisodeSettingsChangeHandle);
 
   Episode->EndPlay();
