+  TArray<FCarlaPathLabelRule> GPathLabelRules;
+  bool bPathLabelRulesLoaded = false;
+
+  void LoadPathLabelRules()
+  {
+    GPathLabelRules.Reset();
+
+    // Projects that are not City Sample can switch the built-ins off wholesale
+    // rather than overriding rules one at a time.
+    bool bUseBuiltins = true;
+    GConfig->GetBool(TEXT("CarlaTagger"), TEXT("bUseBuiltinCitySampleRules"),
+                     bUseBuiltins, GGameIni);
+    if (bUseBuiltins)
+    {
+      for (const auto &Rule : GCitySampleDefaultRules)
+      {
+        GPathLabelRules.Add({FString(Rule.Key), Rule.Value});
+      }
+    }
+
+    // [CarlaTagger] +PathLabel=(Prefix="/Game/Foo", Label="Buildings")
+    TArray<FString> Configured;
+    GConfig->GetArray(TEXT("CarlaTagger"), TEXT("PathLabel"), Configured, GGameIni);
+    for (const FString &Entry : Configured)
+    {
+      FString Prefix, LabelName;
+      if (!FParse::Value(*Entry, TEXT("Prefix="), Prefix) ||
+          !FParse::Value(*Entry, TEXT("Label="), LabelName))
+      {
+        UE_LOG(LogCarla, Warning, TEXT("CarlaTagger: cannot parse PathLabel entry \"%s\""), *Entry);
+        continue;
+      }
+      const crp::CityObjectLabel Label = ATagger::GetTagFromString(LabelName);
+      // An ini rule with an existing prefix replaces the built-in.
+      const int32 Existing = GPathLabelRules.IndexOfByPredicate(
+          [&Prefix](const FCarlaPathLabelRule &R)
+          { return R.Prefix.Equals(Prefix, ESearchCase::IgnoreCase); });
+      if (Existing != INDEX_NONE)
+      {
+        GPathLabelRules[Existing].Label = Label;
+      }
+      else
+      {
+        GPathLabelRules.Add({Prefix, Label});
+      }
+    }
+
+    // Longest prefix first, ties broken alphabetically: TArray::Sort is an
+    // unstable introsort, so the comparator must be total or rule resolution
+    // varies between builds.
+    GPathLabelRules.Sort([](const FCarlaPathLabelRule &A, const FCarlaPathLabelRule &B)
+    {
+      return A.Prefix.Len() != B.Prefix.Len() ? A.Prefix.Len() > B.Prefix.Len()
+                                              : A.Prefix < B.Prefix;
+    });
+
+    bPathLabelRulesLoaded = true;
+    UE_LOG(LogCarla, Log, TEXT("CarlaTagger: %d asset-path label rules loaded (builtins %s)"),
+           GPathLabelRules.Num(), bUseBuiltins ? TEXT("on") : TEXT("off"));
+  }
+}
+
+namespace
+{
+  /// Whether World Partition HLOD proxy meshes get a label.
+  ///
+  /// Off by default: one merged proxy spans many semantic classes, so any
+  /// single label is wrong at every silhouette boundary, and leaving it
+  /// untagged lets the camera fall through to the real streamed meshes.
+  /// Turn it on ([CarlaTagger] bTagHLODProxies=True) when the view is
+  /// dominated by proxies and a coarse label beats none at all.
+  bool ShouldTagHLODProxies()
+  {
+    static bool bCached = false;
+    static bool bValue = false;
+    if (!bCached)
+    {
+      GConfig->GetBool(TEXT("CarlaTagger"), TEXT("bTagHLODProxies"), bValue, GGameIni);
+      bCached = true;
+      UE_LOG(LogCarla, Log, TEXT("CarlaTagger: HLOD proxies are %s"),
+             bValue ? TEXT("TAGGED") : TEXT("skipped"));
+    }
+    return bValue;
+  }
+}
